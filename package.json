{
  "name": "pr-tracker",
  "private": true,
  "version": "0.9.0",
  "description": "Privacy-first Canadian PR & citizenship day tracker (Android, iOS, Web). All data stays on device.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:ircc": "node scripts/fetch-ircc.mjs public/data/ircc.json",
    "data:community": "node scripts/build-community.mjs",
    "cap:sync": "npm run build && cap sync",
    "icons": "node scripts/gen-icons.mjs && npx -y @capacitor/assets@3.0.5 generate --iconBackgroundColor \"#c8102e\" --splashBackgroundColor \"#c8102e\" --splashBackgroundColorDark \"#121211\"",
    "test:visual": "playwright test",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:a11y": "playwright test tests/visual/a11y.spec.ts"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^9.1.2",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "idb-keyval": "^6.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@capacitor/cli": "^7.0.0",
    "@playwright/test": "^1.48.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "sharp": "^0.35.5",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^5.0.5"
  }
}
